{
  "name": "cost-management-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config:generate": "node scripts/generate-runtime-config.mjs",
    "prestart": "npm run config:generate",
    "start": "ng serve",
    "prebuild": "npm run config:generate",
    "build": "ng build",
    "postbuild": "node scripts/scan-bundle-secrets.mjs",
    "prewatch": "npm run config:generate",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run config:generate",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:android": "cap open android",
    "cap:build:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/angular": "^9.0.6",
    "@supabase/supabase-js": "^2.117.2",
    "chart.js": "^4.5.1",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "angular-eslint": "22.5.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.26",
    "prettier": "3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.147.0"
  }
}
