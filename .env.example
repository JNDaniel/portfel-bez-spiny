# Copy to .env for local builds. .env is ignored by Git.
# Only public client values belong here: Supabase URL and publishable key. Never a secret/service_role key.

# local = LocalStorage (default), supabase = Supabase repositories
DATA_BACKEND=local

# Local builds always use the STAGING slot. Point it at the local stack (`npx supabase status`)
# or at the staging project. The PROD slot is used only by Workers Builds on the master branch.
SUPABASE_URL_STAGING=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY_STAGING=
